# =============================================================================
# Reproducibility note
# =============================================================================
# Everything below is regenerable from the scripts in scripts/ and the
# patches in patches/. The canonical entry point is:
#   bash scripts/run_phase_a.sh
# See README.md for the full pipeline.
# =============================================================================

# ---- Upstream source tree (rebuilt by scripts/setup.sh) ----
opus/

# ---- Compiled binaries ----
scripts/encode_raw
scripts/decode_raw

# ---- Large / regenerable data ----
data/raw/
data/pcm/
data/bitstreams/
data/output/

# ---- Log output (regenerable); keep only the curated reference subset ----
logs/
!logs/reference/
!logs/reference/**

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Editor / OS ----
.DS_Store
*.swp
*.swo
.vscode/

# ---- Archives ----
*.tar.gz
*.zip

# ---- Binary artifacts anywhere ----
*.bin
*.pcm

# ---- Copyrighted reference material ----
papers/

# ---- Build artifacts ----
*.o
*.lo
*.la
*.a
*.so
*.so.*

# ---- Error dumps ----
*.err